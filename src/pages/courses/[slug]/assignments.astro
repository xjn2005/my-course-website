---
import { getCollection, type CollectionEntry } from 'astro:content';
import CourseHeader from '../../../components/CourseHeader.astro';
import { coursePath } from '../../../lib/course-path';
import Default from '../../../layouts/Default.astro';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  const assignments = await getCollection('assignments');
  return courses.map((course) => ({
    params: { slug: course.slug },
    props: {
      course,
      assignments: assignments.filter((assignment) => assignment.data.course === course.slug),
    },
  }));
}

const { course, assignments } = Astro.props as {
  course: CollectionEntry<'courses'>;
  assignments: CollectionEntry<'assignments'>[];
};
const date = (value: Date) => value.toLocaleDateString('zh-CN', { timeZone: 'UTC' });
---

<Default title={`${course.data.title} · Assignments`}>
  <CourseHeader course={course} section="assignments" />
  <h2>Assignments</h2>
  <ul class="assignment-list">
    {
      assignments.sort((a, b) => a.data.date.getTime() - b.data.date.getTime()).map((assignment) => {
        const assignmentSlug = assignment.slug.split('/').at(-1)!;
        return (
          <li>
            <time>{date(assignment.data.date)}</time>
            <a href={coursePath(course.slug, `assignments/${assignmentSlug}`)}>{assignment.data.title}</a>
            <span class="assignment-icons">
              {assignment.data.pdf && <a href={assignment.data.pdf} title="题目" aria-label="题目"><i class="fas fa-file-pdf" aria-hidden="true" /></a>}
              {assignment.data.attachment && <a href={assignment.data.attachment} title="附件" aria-label="附件"><i class="fas fa-file-archive" aria-hidden="true" /></a>}
              {assignment.data.solutions && <a href={assignment.data.solutions} title="答案" aria-label="答案"><i class="fas fa-check-circle" aria-hidden="true" /></a>}
            </span>
          </li>
        );
      })
    }
  </ul>
</Default>
