---
import { getCollection } from 'astro:content';
import { sitePath } from '../../lib/course-path';
import Default from '../../layouts/Default.astro';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Default title="Blog">
  <p class="course-back"><a href={sitePath()}>← 课程主页</a></p>
  <h1>Blog</h1>
  <ul class="blog-list">
    {posts.map((post) => (
      <li>
        <a href={sitePath(`blog/${post.slug}`)}>{post.data.title}</a>
        <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('zh-CN')}</time>
      </li>
    ))}
  </ul>
</Default>
