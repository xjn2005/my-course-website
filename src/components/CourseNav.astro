---
import { coursePath } from '../lib/course-path';

const { slug } = Astro.props as { slug: string };
---

<nav aria-label="课程导航">
  <ul class="course-nav">
    <li><a href={coursePath(slug)}>课程主页</a></li>
    <li><a href={coursePath(slug, 'schedule')}>Schedule</a></li>
    <li><a href={coursePath(slug, 'materials')}>Materials</a></li>
    <li><a href={coursePath(slug, 'assignments')}>Assignments</a></li>
  </ul>
</nav>
